#!/usr/bin/env python3
"""
Generate the JSON schema for augur refine configuration files.

This script creates the augur refine configuration schema file.
"""

import itertools
import json
import sys
import os
import copy
from pathlib import Path
from typing import Any, Dict

# Add augur package to Python path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from augur.config import SCHEMA_TYPE_MAP
from augur.refine import refine_options


OUTPUT = Path(__file__).parent.parent / "augur" / "data" / "schema-refine-config.json"

# FIXME: make some of this work with other commands

def create_schema() -> Dict[str, Any]:
    # Initialize the schema with metadata.
    schema = {
        "_description": "This file is generated by devel/regenerate-refine-schema. Do not edit manually - edit the script instead.",
        "$schema": "http://json-schema.org/draft-07/schema#",
        # FIXME: make PR for nextstrain.org https://github.com/nextstrain/nextstrain.org/commit/db84c9c749fc7862323996e68f04bd9588bc7cd8
        "$id": "https://nextstrain.org/schemas/augur/refine-config/v1",
        "title": "Configuration file to be supplied to `augur refine --config`",
        "type": "object",
        "additionalProperties": False,
        "properties": {},
    }

    # Build properties from refine_options
    for key, spec in refine_options.items():
        prop_schema = {}
        if "type" in spec and spec["type"] in SCHEMA_TYPE_MAP:
            prop_schema.update(copy.deepcopy(SCHEMA_TYPE_MAP[spec["type"]]))
        elif "type" in spec:
            prop_schema["type"] = spec["type"]

        if "choices" in spec:
            prop_schema["enum"] = spec["choices"]
        if spec.get("is_file"):
            prop_schema["type"] = "string"
            prop_schema["format"] = "filepath"
        if "oneOf" in spec:
            prop_schema["oneOf"] = spec["oneOf"]
        if "description" in spec:
            prop_schema["description"] = spec["description"]

        schema["properties"][key] = prop_schema

    # Model mutually exclusive groups dynamically from refine_options definitions
    schema["allOf"] = []

    # Collect options belonging to named mutually exclusive groups
    groups: Dict[str, list] = {}
    for key, spec in refine_options.items():
        if "mutually_exclusive_group" in spec:
            groups.setdefault(spec["mutually_exclusive_group"], []).append(key)

    # Track all pairs of mutually exclusive options to avoid duplicate constraints
    covered_pairs = set()
    for group_name, group_keys in groups.items():
        # Generate all unique pairs of options within the group
        pairs = [list(pair) for pair in itertools.combinations(group_keys, 2)]
        for pair in pairs:
            covered_pairs.add(tuple(sorted(pair)))

        # For 2 options, disallow specifying both at once
        if len(group_keys) == 2:
            schema["allOf"].append({
                "comment": f"{', '.join(group_keys)} are mutually exclusive options",
                "not": {"required": group_keys}
            })
        # For 3 or more options, disallow specifying any pair simultaneously
        elif len(group_keys) > 2:
            schema["allOf"].append({
                "comment": f"{', '.join(group_keys)} are mutually exclusive options",
                "not": {
                    "anyOf": [{"required": pair} for pair in pairs]
                }
            })

    # Add constraints for options linked via 'negates' if not already covered by a group
    for key, spec in refine_options.items():
        if "negates" in spec:
            pair = tuple(sorted([key, spec["negates"]]))
            if pair not in covered_pairs:
                covered_pairs.add(pair)
                schema["allOf"].append({
                    "comment": f"{spec['negates']}, {key} are mutually exclusive options",
                    "not": {"required": list(pair)}
                })

    return schema


def main():
    schema = create_schema()
    with open(OUTPUT, 'w') as f:
        json.dump(schema, f, indent=4)
    print(f"Schema generated successfully: {OUTPUT}")


if __name__ == "__main__":
    main()
