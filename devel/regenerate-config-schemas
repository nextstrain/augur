#!/usr/bin/env python3
"""
Generate JSON schemas for commands that support --config via
CustomArgumentParser.
"""

import argparse
import itertools
import json
import os
import sys
from pathlib import Path
from typing import Any

# Add augur package to Python path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from augur import make_parser
from augur.argparse_ import (
    CONFIG_FILE_ARG,
    CustomArgumentParser,
    InputFile,
    SKIP_AUTO_DEFAULT_IN_HELP,
    walk_commands,
)
from augur.config import COMMAND_SCHEMAS


OUTPUT_DIR = Path(__file__).parent.parent / "augur" / "data"


def main():
    parser = make_parser()

    for command_tuple, subparser in walk_commands(parser):
        # if command_tuple is ('augur', 'curate', 'passthru')
        #    command_name  is 'curate passthru'
        command_name = " ".join(command_tuple[1:])

        if command_name not in COMMAND_SCHEMAS:
            continue

        schema = generate_schema_for_command(command_name, subparser)

        output_path = OUTPUT_DIR / f'schema-{command_name.replace(" ", "-")}-config.json'
        with open(output_path, "w") as f:
            json.dump(schema, f, indent=4)
            f.write("\n")

        print(f"Schema generated successfully: {output_path}")


def generate_schema_for_command(command_name: str, subparser: CustomArgumentParser) -> dict[str, Any]:
    version = COMMAND_SCHEMAS[command_name]
    properties = extract_properties(subparser)
    constraints = extract_constraints(subparser, properties)

    schema: dict[str, Any] = {
        "_description": "This file is generated by devel/generate-config-schemas. Do not edit manually - edit the script instead.",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": f'https://nextstrain.org/schemas/augur/{command_name.replace(" ", "-")}-config/{version}',
        "title": f"Configuration file to be supplied to `augur {command_name} {CONFIG_FILE_ARG}`",
        "type": "object",
        "additionalProperties": False,
        "properties": properties,
    }
    # NOTE: Nothing is required because everything can also be set in the CLI.
    # Though, the CLI help text still says required for options that can now be
    # set in --config.

    if constraints:
        schema["allOf"] = constraints

    return schema


def extract_properties(subparser: CustomArgumentParser) -> dict[str, Any]:
    properties: dict[str, Any] = {}

    for action in subparser._actions:
        # Skip --help
        if isinstance(action, argparse._HelpAction):
            continue

        # Skip positionals
        if not action.option_strings:
            continue

        # Skip CLI-only
        if getattr(action, "cli_only", False):
            continue

        # Skip --config
        if action.option_strings == [CONFIG_FILE_ARG]:
            continue

        # CustomArgumentParser only exposes one config key per option.
        config_key = subparser.get_possible_config_keys(action)[0]
        properties[config_key] = extract_property(action)

    return properties


def extract_property(action: argparse.Action) -> dict[str, Any]:
    """
    Convert an argparse.Action to a JSON Schema property definition.
    """
    prop: dict[str, Any] = {}

    if description := clean_help_string(action.help):
        prop["description"] = description

    # Determine type and values
    if isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction)):
        prop["type"] = "boolean"
    elif action.type is InputFile:
        prop["type"] = "string"
        prop["format"] = "filepath"
    else:
        schema_type = get_schema_type(action.type)
        if action.nargs in (argparse.ZERO_OR_MORE, argparse.ONE_OR_MORE):
            prop["oneOf"] = [
                {"type": schema_type},
                {"type": "array", "items": {"type": schema_type}},
            ]
        else:
            prop["type"] = schema_type

    if action.choices:
        prop["enum"] = list(action.choices)

    # Default values
    if action.default not in (None, argparse.SUPPRESS):
        # Drop misleading default for store_false actions
        if isinstance(action, argparse._StoreFalseAction) and action.default is True:
            pass
        else:
            prop["default"] = action.default

    return prop


def get_schema_type(action_type: Any) -> str:
    """
    Map an argparse.Action's type to a JSON Schema primitive type.
    """
    if action_type is int:
        return "integer"
    elif action_type is float:
        return "number"
    else:
        return "string"


def extract_constraints(
    subparser: CustomArgumentParser,
    properties: dict[str, Any],
) -> list[dict[str, Any]]:
    """
    Extract constraints from mutually exclusive groups and actions sharing the
    same destination variable.
    """
    exclude_pairs = set()

    # 1. Groups from add_mutually_exclusive_group()
    for group in subparser._mutually_exclusive_groups:
        group_keys: list[str] = []
        for action in group._group_actions:
            keys = subparser.get_possible_config_keys(action)
            for k in keys:
                if k in properties and k not in group_keys:
                    group_keys.append(k)

        if len(group_keys) > 1:
            for k1, k2 in itertools.combinations(sorted(group_keys), 2):
                exclude_pairs.add((k1, k2))

    # 2. Actions sharing the same destination variable (e.g. store_true/store_false pairs)
    dest_to_keys: dict[str, list[str]] = {}
    for action in subparser._actions:
        if not action.dest:
            continue

        keys = subparser.get_possible_config_keys(action)
        if keys and keys[0] in properties:
            key = keys[0]
            if key not in dest_to_keys.setdefault(action.dest, []):
                dest_to_keys[action.dest].append(key)

    for dest, keys in dest_to_keys.items():
        if len(keys) > 1:
            for k1, k2 in itertools.combinations(sorted(keys), 2):
                exclude_pairs.add((k1, k2))

    return [
        {"not": {"required": [k1, k2]}}
        for k1, k2 in sorted(exclude_pairs)
    ]


def clean_help_string(help_text: str | None) -> str:
    if not help_text:
        return ""

    # Remove argparse-specific formatting tokens.
    return help_text.replace(SKIP_AUTO_DEFAULT_IN_HELP, "")


if __name__ == "__main__":
    main()
